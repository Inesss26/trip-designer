# --- Supabase ---------------------------------------------------------------
# Tant que ces variables sont absentes, le site tourne en « mode démo » :
# les données viennent de lib/data/demo.ts et les écritures ne sont pas persistées.
# Projet Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : côté serveur uniquement, ne JAMAIS l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administration ---------------------------------------------------------
# Mot de passe unique d'accès à /admin.
ADMIN_PASSWORD=change-moi
# Secret de signature du cookie de session (32 caractères minimum).
# Générer avec : openssl rand -base64 32
ADMIN_SESSION_SECRET=remplace-ce-secret-par-32-caracteres-minimum
