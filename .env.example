# --- Supabase ---------------------------------------------------------------
# Tant que ces variables sont absentes, le site tourne en « mode démo » :
# les données viennent de lib/data/demo.ts et les écritures ne sont pas persistées.
# Projet Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique, exposée au navigateur. Supabase la nomme désormais
# « publishable key » (sb_publishable_…) ; les anciens projets utilisent
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Les deux noms sont acceptés.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé serveur, utilisée uniquement par l'administration : côté serveur
# exclusivement, ne JAMAIS l'exposer au navigateur. Supabase la nomme désormais
# « secret key » (sb_secret_…) ; SUPABASE_SERVICE_ROLE_KEY reste accepté.
SUPABASE_SECRET_KEY=

# --- Contact (Web3Forms) ----------------------------------------------------
# Clé créée sur https://web3forms.com avec l'adresse agathe@mytripdesigner.fr.
# Sans cette variable, le formulaire n'envoie pas d'e-mail en production.
WEB3FORMS_ACCESS_KEY=

# --- Administration ---------------------------------------------------------
# Mot de passe unique d'accès à /admin.
ADMIN_PASSWORD=change-moi
# Secret de signature du cookie de session (32 caractères minimum).
# Générer avec : openssl rand -base64 32
ADMIN_SESSION_SECRET=remplace-ce-secret-par-32-caracteres-minimum
